{
  "$description": "The Kleidos design tokens. DTCG-shaped: a token is an object with $value and $type. A color's $value is a CSS color string, a hex where it is opaque. A token with $compose is computed (one color at an alpha over another) and never stored. Each group names its owner: 'brand' is kept here; 'kleidos' is a mirror of the firmware repository, the source for now, held to it by tools/sync_from_kleidos.py.",
  "brand": {
    "$owner": "brand",
    "$description": "The two colors of the mark, and how the mark is built.",
    "signal": {
      "$value": "#00d2ff",
      "$type": "color",
      "$description": "The mark's ring and keyhole; what can be pressed; the device's own cyan"
    },
    "select": {
      "$value": "#0f3460",
      "$type": "color",
      "$description": "The mark's body; the fill of a selection"
    },
    "logo": {
      "$description": "The mark on its 100-unit box, centered on the origin. logo/src/mark.svg is these numbers drawn.",
      "box": {
        "$value": 100,
        "$type": "number",
        "$description": "Side of the mark box"
      },
      "ring-radius": {
        "$value": 42,
        "$type": "number"
      },
      "ring-stroke": {
        "$value": 3,
        "$type": "number"
      },
      "body-width": {
        "$value": 28,
        "$type": "number"
      },
      "body-height": {
        "$value": 56,
        "$type": "number"
      },
      "body-radius": {
        "$value": 14,
        "$type": "number"
      },
      "body-stroke": {
        "$value": 2.5,
        "$type": "number"
      },
      "bit-radius": {
        "$value": 5,
        "$type": "number"
      },
      "bit-cy": {
        "$value": -4,
        "$type": "number",
        "$description": "The bit's center, above the box's center"
      },
      "stem-width": {
        "$value": 3,
        "$type": "number"
      },
      "stem-height": {
        "$value": 14,
        "$type": "number"
      },
      "clear-space": {
        "$value": 0.5,
        "$type": "number",
        "$description": "Free space kept on every side of the mark or a lockup, as a share of the mark box"
      },
      "min-px-on-dark": {
        "$value": 24,
        "$type": "number",
        "$description": "Smallest mark on a screen, on a dark ground, in pixels of the mark box"
      },
      "min-px-on-light": {
        "$value": 48,
        "$type": "number",
        "$description": "Smallest color mark on a light ground; below it, the mark on its dark tile or the one-ink mark"
      },
      "min-mm-print": {
        "$value": 6,
        "$type": "number",
        "$description": "Smallest mark in print, in millimeters of the mark box"
      }
    }
  },
